# ---- service
APP_NAME=incubrix-broll-engine
DATA_DIR=./data
# empty = sqlite file in DATA_DIR; compose uses postgresql+psycopg://broll:broll@db:5432/broll
DATABASE_URL=
PUBLIC_BASE_URL=http://localhost:8000
# if set, /api/v1 routes require "Authorization: Bearer <API_TOKEN>" (UI: open /?token=<API_TOKEN>)
API_TOKEN=
RATE_LIMIT_PER_MINUTE=30
WORKER_THREADS=2
LOG_LEVEL=INFO
PRELOAD_MODELS=true

# ---- storage: local | s3 (MinIO or any S3-compatible store)
STORAGE_BACKEND=local
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=
S3_BUCKET=broll-outputs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
LINK_TTL_SECONDS=604800

# ---- input limits
MAX_AUDIO_SECONDS=600
MAX_UPLOAD_MB=100
MAX_SCRIPT_CHARS=12000

# ---- adapters (every one has a "mock")
ASR_PROVIDER=whisper
WHISPER_MODEL=base
WHISPER_ALIGN_MODEL=tiny
TTS_PROVIDER=gemini,kokoro,espeak
GEMINI_TTS_MODEL=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts,gemini-2.5-flash-preview-tts,gemini-3.1-flash-tts-preview
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-flash-lite-latest
RERANK_PROVIDER=clip
INTERPRET_PROVIDER=gemini
INTERPRET_MODEL=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k
FOOTAGE_PROVIDERS=pixabay,coverr,pexels,nasa,wikimedia,internet_archive,openverse_images
AI_IMAGE_PROVIDER=cloudflare
CLOUDFLARE_MODEL=@cf/black-forest-labs/flux-1-schnell
MUSIC_PROVIDER=openverse
PROVIDER_TIMEOUT_SECONDS=20
LLM_TIMEOUT_SECONDS=10
# comma list of sources to switch off (outage testing), e.g. pixabay,openverse
DISABLED_PROVIDERS=

# ---- keys (never commit real values)
GEMINI_API_KEY=
PIXABAY_API_KEY=
COVERR_API_KEY=
PEXELS_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
FREESOUND_API_KEY=
CALLBACK_SECRET=change-me

# ---- source-selection rule
STOCK_MIN_SCORE=0.24
AI_MARGIN=0.02
CANDIDATES_PER_QUERY=6
QUERIES_PER_SCENE=3
MAX_SCORED_CANDIDATES=12
MIN_SCENE_SECONDS=2.0
MAX_SCENE_SECONDS=8.0

# ---- render
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
FPS=30
# libx264 (CPU, portable) | h264_amf (AMD GPU) | h264_nvenc (NVIDIA) | h264_qsv (Intel)
VIDEO_ENCODER=libx264
VIDEO_PRESET=veryfast
RENDER_PARALLEL=6
MULTI_RATIO_RENDER=true
HW_DECODE=true
PARALLAX=true
FFMPEG_THREADS=2
VIDEO_CRF=23
MUSIC_VOLUME_DB=-20
SEED=1234
